<div class="flex items-center">
  <h1 class="app-main-title">{{ translate('e-Invoice') }} > {{ translate('Providers') }}</h1>
  {% if viewParams.settingsSaved %}
    <div class="badge badge-info text-sm ml-4">{{ translate('Settings saved.') }}</div>
  {% endif %}
</div>

<div class="mt-8 flex flex-col md:flex-row gap-4 items-start">
  <div class="card w-full md:w-1/3">
    <div class="p-4">
      <div class="text-lg font-bold">{{ translate('e-Invoice providers') }}</div>
      <div class="text-sm text-gray-500 mt-1">
        {{ translate('Choose the service used to exchange documents over Peppol.') }}
      </div>

      <div class="flex flex-col gap-2 mt-4">
        {% for providerCode, provider in viewParams.providerDefinitions %}
          <a
            href="?providerConfig={{ providerCode }}"
            class="btn btn-list-item w-full {{ viewParams.providerName == providerCode ? 'btn-primary' : 'btn-transparent' }}"
            style="display: flex; align-items: center; column-gap: 1rem"
          >
            {% if provider.logoUrl %}
              <img
                src="{{ provider.logoUrl }}"
                alt=""
                style="height: 1.5rem; width: auto; max-width: 6rem; object-fit: contain; flex-shrink: 0; {{ providerCode == 'epostak' ? 'margin-right: -1.5rem' : '' }}"
              />
            {% endif %}
            <span class="text flex-grow text-left" style="min-width: 0">
              <b>{{ provider.name }}</b>
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="card w-full md:w-2/3">
      <div class="p-4" style="display: flex; align-items: center; column-gap: 1rem">
      {% if viewParams.providerDefinition.logoUrl %}
        <img
          src="{{ viewParams.providerDefinition.logoUrl }}"
          alt=""
          style="height: 2.5rem; width: auto; max-width: 10rem; object-fit: contain; flex-shrink: 0"
        />
      {% endif %}
      <div class="flex-grow" style="min-width: 0">
        <div class="text-xl font-bold" style="display: block">{{ viewParams.providerDefinition.name }}</div>
        <div class="text-sm text-gray-500" style="display: block">{{ translate(viewParams.providerDefinition.description) }}</div>
      </div>
    </div>

    {% if viewParams.providerDefinition.setupHint|default('') %}
      <div class="px-4 pb-4 text-sm text-gray-500">{{ translate(viewParams.providerDefinition.setupHint) }}</div>
    {% endif %}

    <form id="settings-form" action="" method="POST">
      <input type="hidden" name="settingsChanged" value="1">
      <input type="hidden" name="providerName" value="{{ viewParams.providerName }}">
      <table class="table-default">
        <tbody>
          {% for fieldName, field in viewParams.providerDefinition.fields %}
            {% set fieldValue = viewParams.providerConfig[fieldName] ?? field.default %}
            <tr>
              <td>
                {{ translate(field.label) }}
                {% if field.type == 'password' and fieldValue != '' %}
                  <span class="text-green-500 ml-1 text-sm" title="{{ translate('Secret is set') }}">({{ translate('set') }})</span>
                {% endif %}
              </td>
              <td>
                <input
                  type="{{ field.type }}"
                  name="{{ fieldName }}"
                  class="hubleto component input"
                  value="{{ field.type == 'password' ? '' : fieldValue }}"
                  placeholder="{{ field.type == 'password' and fieldValue != '' ? '********' : '' }}"
                />
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="mt-4 flex justify-start px-4 pb-4">
        {% if viewParams.providerDefinition.available %}
          <button type="submit" class="btn btn-add">
            <span class="icon"><i class="fas fa-save"></i></span>
            <span class="text">{{ translate('Save and use provider') }}</span>
          </button>
        {% else %}
          <button type="button" class="btn btn-transparent" disabled>
            <span class="icon"><i class="fas fa-flask"></i></span>
            <span class="text">{{ translate('Template only') }}</span>
          </button>
        {% endif %}
      </div>
    </form>
  </div>
</div>
