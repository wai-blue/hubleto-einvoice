{% macro providerLogo(provider) %}
  <span class="flex h-8 w-20 shrink-0 items-center justify-center" aria-hidden="true">
    {% if provider.logoUrl %}
      <img src="{{ provider.logoUrl }}" alt="" width="80" height="32" class="h-8 w-20 object-contain" />
    {% else %}
      <i class="fas fa-file-invoice"></i>
    {% endif %}
  </span>
{% endmacro %}

<div class="flex items-center">
  <h1 class="app-main-title">{{ translate('e-Invoice') }} > {{ translate('Providers') }}</h1>
  {% if viewParams.settingsSaved %}
    <div class="badge badge-info text-sm ml-4">{{ translate('Settings saved.') }}</div>
  {% endif %}
</div>

<div class="mt-8 flex flex-col md:flex-row gap-4 items-start">
  <div class="card w-full md:w-1/3">
    <div class="p-4">
      <div class="text-lg font-bold">{{ translate('e-Invoice providers') }}</div>
      <div class="text-sm text-gray-500 mt-1">
        {{ translate('Choose the service used to exchange documents over Peppol.') }}
      </div>

      <div class="flex flex-col gap-2 mt-4">
        {% for providerCode, provider in viewParams.providerDefinitions %}
          <a
            href="?providerConfig={{ providerCode }}"
            class="btn btn-list-item grid grid-cols-[5rem_minmax(0,1fr)] items-center gap-x-3 min-h-12 px-2 py-2 {{ viewParams.providerName == providerCode ? 'btn-primary' : 'btn-transparent' }}"
            aria-current="{{ viewParams.providerName == providerCode ? 'page' : 'false' }}"
          >
            {{ _self.providerLogo(provider) }}
            <span class="min-w-0 whitespace-normal break-words text-left">
              <b>{{ provider.name }}</b>
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="card w-full md:w-2/3">
    <div class="flex items-center gap-4 p-4">
      {{ _self.providerLogo(viewParams.providerDefinition) }}
      <div class="min-w-0 flex-grow">
        <div class="text-xl font-bold">{{ viewParams.providerDefinition.name }}</div>
        <div class="text-sm text-gray-500">{{ translate(viewParams.providerDefinition.description) }}</div>
      </div>
    </div>

    <form id="settings-form" action="" method="POST">
      <input type="hidden" name="settingsChanged" value="1">
      <input type="hidden" name="providerName" value="{{ viewParams.providerName }}">
      <table class="table-default w-full table-fixed">
        <colgroup><col class="w-1/3"><col class="w-2/3"></colgroup>
        <tbody>
          {% for fieldName, field in viewParams.providerDefinition.fields %}
            {% set fieldValue = viewParams.providerConfig[fieldName] ?? field.default %}
            <tr>
              <td>
                <label for="einvoice-provider-{{ fieldName }}">{{ translate(field.label) }}</label>
                {% if field.type == 'password' and fieldValue != '' %}
                  <span class="text-green-500 ml-1 text-sm" title="{{ translate('Secret is set') }}">({{ translate('set') }})</span>
                {% endif %}
              </td>
              <td>
                <input
                  type="{{ field.type }}"
                  id="einvoice-provider-{{ fieldName }}"
                  name="{{ fieldName }}"
                  class="hubleto component input"
                  value="{{ field.type == 'password' ? '' : fieldValue }}"
                  placeholder="{{ field.type == 'password' and fieldValue != '' ? '********' : '' }}"
                />
              </td>
            </tr>
          {% endfor %}
          <tr>
            <td>
              <label for="einvoice-auto-create">{{ translate('Create inbound Hubleto invoices automatically') }}</label>
            </td>
            <td>
              <input
                type="checkbox"
                id="einvoice-auto-create"
                name="autoCreateInvoices"
                value="1"
                {{ viewParams.providerConfig.autoCreateInvoices|default('0') == '1' ? 'checked' : '' }}
                class="h-4 w-4 p-0"
              >
            </td>
          </tr>
          <tr>
            <td>
              <label for="einvoice-notification-email">{{ translate('Inbound invoice notification email') }}</label>
            </td>
            <td>
              <input
                type="email"
                name="notificationEmail"
                id="einvoice-notification-email"
                class="hubleto component input"
                value="{{ viewParams.providerConfig.notificationEmail|default('') }}"
                aria-describedby="einvoice-notification-email-help"
              >
              <div id="einvoice-notification-email-help" class="text-sm text-gray-500 mt-2">
                {{ translate('Enter your email address to receive a notification when a new inbound e-Invoice is received.') }}
              </div>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="mt-4 flex justify-start px-4 pb-4">
        {% if viewParams.providerDefinition.available %}
          <button type="submit" class="btn btn-add">
            <span class="icon"><i class="fas fa-save"></i></span>
            <span class="text">{{ translate('Save and use provider') }}</span>
          </button>
        {% else %}
          <button type="button" class="btn btn-transparent" disabled>
            <span class="icon"><i class="fas fa-flask"></i></span>
            <span class="text">{{ translate('Template only') }}</span>
          </button>
        {% endif %}
      </div>
    </form>
  </div>
</div>
