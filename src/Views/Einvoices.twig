<h1 class="app-main-title">{{ translate('e-Invoice') }}</h1>

{% set sync = viewParams.lastSynchronization %}
{% if sync.startedAt %}
  <div class="card p-4 mb-4" role="status">
    <div class="flex flex-wrap items-center gap-2">
      <strong>{{ translate('Last synchronization') }}</strong>
      <span class="badge {{ sync.status == 'success' ? 'badge-success' : (sync.status == 'running' ? 'badge-info' : (sync.status == 'error' ? 'badge-danger' : 'badge-warning')) }}">{{ translate(sync.status) }}</span>
      <span>{{ sync.finishedAt|default(sync.startedAt) }} ({{ translate(sync.source) }})</span>
    </div>
    {% if sync.documents %}
      <div class="text-sm mt-2">
        {{ translate('Found') }}: {{ sync.documents.found }}, {{ translate('Imported') }}: {{ sync.documents.imported }},
        {{ translate('Updated') }}: {{ sync.documents.updated }}, {{ translate('Unchanged') }}: {{ sync.documents.unchanged }},
        {{ translate('Hubleto invoices created') }}: {{ sync.documents.hubletoInvoicesCreated|default(0) }},
        {{ translate('Notifications sent') }}: {{ sync.documents.notificationsSent|default(0) }}.
        {{ sync.documents.cycleCompleted ? translate('All provider invoices were checked.') : translate('The next synchronization will continue with the next batch.') }}
      </div>
    {% endif %}
    {% if sync.statuses %}<div class="text-sm mt-1">{{ translate('Statuses checked') }}: {{ sync.statuses.checked }}. {{ translate('Failed') }}: {{ sync.statuses.failed }}.</div>{% endif %}
    {% for error in sync.errors|default([]) %}
      <div class="alert alert-danger text-sm mt-2">{{ error }}</div>
    {% endfor %}
    {% for warning in sync.documents.warnings|default([]) %}
      <div class="alert alert-warning text-sm mt-2">{{ warning }}</div>
    {% endfor %}
  </div>
{% else %}
  <div class="text-sm text-gray-500 mb-4">{{ translate('No synchronization result has been recorded yet. Use Sync from provider or wait for the next scheduled synchronization.') }}</div>
{% endif %}

{% if viewParams.invoiceSyncResult %}
  <div class="badge badge-info mb-2">
    {{ translate('Provider invoices synchronized.') }}
    {{ translate('Found') }}: {{ viewParams.invoiceSyncResult.found }},
    {{ translate('Imported') }}: {{ viewParams.invoiceSyncResult.imported }},
    {{ translate('Updated') }}: {{ viewParams.invoiceSyncResult.updated }},
    {{ translate('Linked') }}: {{ viewParams.invoiceSyncResult.linked }},
    {{ translate('Unchanged') }}: {{ viewParams.invoiceSyncResult.unchanged }}.
    {% if viewParams.invoiceSyncResult.cycleCompleted %}
      {{ translate('All provider invoices were checked.') }}
    {% else %}
      {{ translate('Click sync again to process the next batch.') }}
    {% endif %}
  </div>
  {% for warning in viewParams.invoiceSyncResult.warnings %}
    <div class="badge badge-warning mb-2">{{ warning }}</div>
  {% endfor %}
{% endif %}

{% if viewParams.invoiceSyncError %}
  <div class="badge badge-danger mb-2">{{ viewParams.invoiceSyncError }}</div>
{% endif %}

<hblreact-table-einvoices
  string:tag="table-einvoices"
  int:record-id="{{ viewParams.recordId }}"
  string:fulltext-search='{{ viewParams.q }}'
  json:column-search='{{ viewParams.search|json_encode }}'
  json:filters='{{ viewParams.filters|json_encode }}'
  string:form-active-tab-uid='{{ viewParams.tab }}'
></hblreact-table-einvoices>
